NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Paste the raw JSON service account credentials string
FIREBASE_SERVICE_ACCOUNT=
# Comma-separated list of admin emails allowed to manage content
FIREBASE_ALLOWED_EMAILS=

# --- Embedded notes ---
# Base URL of the w_notes API; the admin note picker reads from it server-side.
W_NOTES_API_BASE=
# Shared secret for w_notes. Authenticates both the inbound ingest of note
# updates and the outbound picker reads. Must equal PORTFOLIO_INGEST_SECRET
# on the w_notes side.
NOTES_INGEST_SECRET=

# --- Aiko mirroring ---
# Art and photo posts are pushed to Aiko as pins on publish. Leave either
# variable blank to disable the mirror entirely (local dev, staging).
# Base URL of the Aiko API, e.g. https://api.try-aiko.com
AIKO_INGEST_URL=
# Shared secret for Aiko. Must equal PORTFOLIO_INGEST_SECRET on the Aiko side.
AIKO_INGEST_SECRET=
# Public base URL of this site. Used to build the "via" link on each Aiko pin
# (https://<this>/<category>/<slug>). Unset means pins carry no back-link.
PORTFOLIO_PUBLIC_URL=
# Public Aiko site, for the pin links in Instagram captions.
AIKO_PUBLIC_URL=https://www.try-aiko.com

# --- Now playing (mariposa) ---
# Shared secret the mariposa app sends with what is playing. Paste the same
# value into mariposa's Settings. Unset disables the ingest endpoints; the
# public read then just reports nothing playing.
PRESENCE_INGEST_SECRET=

# --- Shop (Stripe payments + Printify fulfilment) ---
# Stripe secret key. Start with sk_test_..., switch to sk_live_... to sell.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...) pointed at
# https://<api-host>/api/shop/webhooks/stripe, or printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Printify personal access token (Account -> Connections) and the shop id
# (`python scripts/printify_setup.py shops`).
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# Random secret Printify signs its order webhooks with (openssl rand -hex 20).
PRINTIFY_WEBHOOK_SECRET=
# Off: live orders land in Printify on hold until approved in its dashboard.
# On: they go straight to production.
PRINTIFY_AUTO_SUBMIT=false
# On: Stripe test-mode payments also create (on-hold) Printify orders.
PRINTIFY_TEST_ORDERS=false
# Where Stripe sends buyers back to. Falls back to PORTFOLIO_PUBLIC_URL.
SHOP_PUBLIC_URL=
# Email the owner about meetup requests/offers and online meetup purchases
# (https://resend.com). Leave either blank to send no email. Without a
# verified domain, SHOP_NOTIFY_EMAIL must be the Resend account's own email.
RESEND_API_KEY=
SHOP_NOTIFY_EMAIL=
# Optional sender, e.g. "Shop <shop@yourdomain.com>" once a domain is verified.
SHOP_EMAIL_FROM=

# --- Instagram publishing ---
# Every new photo post is published to Instagram unless its "Post to Instagram"
# toggle was switched off. It only follows posts that went to Aiko (the "Post to
# Aiko" switch is on and Aiko accepted it), since the caption is the description
# plus a link to the post's Aiko pin. Leave either of the first two variables
# blank to disable publishing entirely (local dev, staging) -- photos then just
# mirror to Aiko as before.
#
# Uses the Instagram API with Instagram Login, so this needs a professional
# (Business or Creator) account and no Facebook Page. Scopes required on the
# token: instagram_business_basic, instagram_business_content_publish.
#
# Numeric id of the Instagram professional account to publish to.
INSTAGRAM_USER_ID=
# Long-lived access token. Expires after 60 days -- run
# `python refresh_instagram_token.py` monthly and update this value.
INSTAGRAM_ACCESS_TOKEN=
# Graph API version. Bump when Meta deprecates the current one.
INSTAGRAM_GRAPH_VERSION=v23.0
# Override only if using the Facebook Login flow instead
# (https://graph.facebook.com).
INSTAGRAM_GRAPH_HOST=https://graph.instagram.com
